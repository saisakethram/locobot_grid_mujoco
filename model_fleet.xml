<mujoco model="locobot_fleet_v1">
  <!-- Dimensions extracted from Full_Grid.glb (meters):
       lanes y=0.231/0.551, stations x=0.211/1.251, segment 292mm, gauge 80mm,
       fixed rails x 0.391..1.091, bot 247x228mm, charging bay x>1.40 -->

  <compiler angle="radian"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual><headlight ambient="0.45 0.45 0.45" diffuse="0.55 0.55 0.55"/></visual>

  <default>
    <joint damping="0.05"/>
    <position kp="8" forcerange="-1.47 1.47"/>
    <!-- Waveshare SC15 arm servo: 17 kg.cm @ 8.4 V = 1.67 N.m. kp is a GUESS
         (full torque at ~5 deg error) until the bench sag test measures it.
         armature = gearbox-reflected rotor inertia; dampratio = critically
         damped, so the servo itself doesn't ring. -->
    <default class="sc15">
      <position kp="20" dampratio="1" forcerange="-1.67 1.67"/>
      <joint armature="0.01"/>
    </default>
    <!-- claw: outer links driven by the 6th SC15 (same gains/cap), range = jaw travel -->
    <default class="claw">
      <joint type="hinge" range="0 1.2" armature="0.002" damping="0.02"/>
      <position kp="20" dampratio="1" forcerange="-1.67 1.67" ctrlrange="0 1.2"/>
    </default>
    <!-- jaw counter-rotation joint: held at -(link angle) by equality = parallelogram -->
    <default class="claw_jaw">
      <joint type="hinge" range="-1.2 0" armature="0.002" damping="0.02"/>
    </default>
    <!-- the parallelogram's inner link is a rigid bar: stiffest stable equality
         (timeconst = 2x timestep), else squeeze torque twists the jaws -->
    <default class="rigid_link">
      <equality solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>
    <default class="claw_link">
      <geom type="box" size="0.0025 0.003 0.0175" mass="0.005" rgba="0.2 0.2 0.22 1"/>
    </default>
    <default class="claw_jawplate">
      <geom type="box" size="0.0035 0.010 0.006" mass="0.006" rgba="0.2 0.2 0.22 1"/>
    </default>
    <!-- jaw pads: rubber-ish friction + torsional (condim 4) so a pinched cube
         doesn't spin out. priority=1 makes the pad's contact params win over the
         object's; stiff solref/solimp keep a full-torque squeeze (~48 N) from
         sinking the pads mm-deep into a 30 g cube (default contact = 5 mm) -->
    <default class="jaw">
      <geom type="box" size="0.0065 0.010 0.0093" mass="0.005" rgba="0.9 0.7 0.1 1"
            condim="4" friction="1.2 0.02 0.001" priority="1"
            solref="0.004 1" solimp="0.95 0.99 0.0005"/>
    </default>
    <!-- visual-only parts (hubs, inner links): no contact, no mass -->
    <default class="claw_vis">
      <geom contype="0" conaffinity="0" mass="0"/>
      <joint type="hinge" armature="0.0001" damping="0.001"/>
    </default>
    <default class="frame">
      <geom contype="0" conaffinity="0" rgba="0.15 0.15 0.15 1"/>
    </default>
    <default class="cweb">
      <geom contype="0" conaffinity="0" type="box" rgba="0.45 0.45 0.48 1"/>
    </default>
  </default>


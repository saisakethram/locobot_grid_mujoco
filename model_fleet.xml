                <joint class="sc15" name="j5_wrist_roll_b2" type="hinge" axis="0 0 1" range="-3.1 3.1"/>
                <!-- gripper tip: wrist pitch -> tip = 90 + 64.8 = 154.8 mm (doc L3) -->
                <site name="tip_b2" pos="0 0 -0.0648" size="0.006" rgba="1 0.4 0 1"/>
                <!-- two-finger PARALLEL claw: the 6th SC15 is the palm. Each side is a
                     parallelogram 4-bar: the horn drives the outer link (claw_r), a 1:1
                     gear pair mirrors it (claw_l), and the jaw hangs from the link ends
                     counter-rotated by the link angle (equalities below), so the pad
                     faces stay vertical and parallel while translating on a 35 mm arc.
                     Inner links are visual. Pads 18.62 mm tall (README "jaw tip"),
                     centered on the tip site when closed.
                     claw angle 0 = closed (2 mm pad gap), 1.2 rad = open (~67 mm gap). -->
                <geom name="palm_b2" type="box" size="0.026 0.012 0.015" pos="0 0 -0.015" mass="0.06" rgba="0.2 0.2 0.22 1"/>
                <geom class="claw_vis" type="cylinder" size="0.005 0.013" zaxis="0 1 0" pos=" 0.020 0 -0.030" rgba="0.85 0.45 0.25 1"/>
                <geom class="claw_vis" type="cylinder" size="0.005 0.013" zaxis="0 1 0" pos="-0.020 0 -0.030" rgba="0.85 0.45 0.25 1"/>
                <body name="link_r_b2" pos="0.020 0 -0.030">
                  <joint class="claw" name="claw_r_b2" axis="0 -1 0"/>
                  <geom class="claw_link" pos="0 0.006 -0.0175"/>
                  <geom class="claw_link" pos="0 -0.006 -0.0175"/>
                  <body name="jaw_r_b2" pos="0 0 -0.035">
                    <joint class="claw_jaw" name="jaw_r_b2" axis="0 -1 0"/>
                    <geom class="claw_jawplate" pos="-0.005 0 0.002"/>
                    <geom class="jaw" name="pad_r_b2" pos="-0.0125 0 0.0002"/>
                  </body>
                </body>
                <body name="link2_r_b2" pos="0.010 0 -0.030">
                  <joint class="claw_vis" name="link2_r_b2" axis="0 -1 0"/>
                  <geom class="claw_vis" type="box" size="0.002 0.003 0.0175" pos="0 0 -0.0175" mass="0.001" rgba="0.35 0.35 0.38 1"/>
                </body>
                <body name="link_l_b2" pos="-0.020 0 -0.030">
                  <joint class="claw" name="claw_l_b2" axis="0 1 0"/>
                  <geom class="claw_link" pos="0 0.006 -0.0175"/>
                  <geom class="claw_link" pos="0 -0.006 -0.0175"/>
                  <body name="jaw_l_b2" pos="0 0 -0.035">
                    <joint class="claw_jaw" name="jaw_l_b2" axis="0 1 0"/>
                    <geom class="claw_jawplate" pos="0.005 0 0.002"/>
                    <geom class="jaw" name="pad_l_b2" pos="0.0125 0 0.0002"/>
                  </body>
                </body>
                <body name="link2_l_b2" pos="-0.010 0 -0.030">
                  <joint class="claw_vis" name="link2_l_b2" axis="0 1 0"/>
                  <geom class="claw_vis" type="box" size="0.002 0.003 0.0175" pos="0 0 -0.0175" mass="0.001" rgba="0.35 0.35 0.38 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ============ CUBES on the table: 40 mm, 30 g (PLA-ish), free bodies ============
         Three per end table, resting on the top (center z = -0.25 + 0.02),
         0.14-0.23 m ahead of a bot parked at the lane end, most turned a
         little (euler z, rad) so perception and claw roll get exercised. Declared
         last so the bot/turntable joint indices above are unchanged. -->
    <body name="cube_red" pos="1.84 0.191 -0.23">
      <freejoint name="cube_red_free"/>
      <geom name="cube_red" type="box" size="0.02 0.02 0.02" mass="0.03" rgba="0.85 0.2 0.2 1"/>
    </body>
    <body name="cube_green" pos="1.84 0.271 -0.23" euler="0 0 0.35">
      <freejoint name="cube_green_free"/>
      <geom name="cube_green" type="box" size="0.02 0.02 0.02" mass="0.03" rgba="0.25 0.7 0.3 1"/>
    </body>
    <body name="cube_blue" pos="1.91 0.231 -0.23" euler="0 0 -0.61">
      <freejoint name="cube_blue_free"/>
      <geom name="cube_blue" type="box" size="0.02 0.02 0.02" mass="0.03" rgba="0.2 0.4 0.85 1"/>
    </body>
    <body name="cube_yellow" pos="1.84 0.511 -0.23" euler="0 0 0.17">
      <freejoint name="cube_yellow_free"/>
      <geom name="cube_yellow" type="box" size="0.02 0.02 0.02" mass="0.03" rgba="0.95 0.8 0.15 1"/>
    </body>
    <body name="cube_purple" pos="1.84 0.591 -0.23" euler="0 0 0.79">
      <freejoint name="cube_purple_free"/>
      <geom name="cube_purple" type="box" size="0.02 0.02 0.02" mass="0.03" rgba="0.6 0.3 0.75 1"/>
    </body>
    <body name="cube_orange" pos="1.91 0.551 -0.23" euler="0 0 -0.26">
      <freejoint name="cube_orange_free"/>
      <geom name="cube_orange" type="box" size="0.02 0.02 0.02" mass="0.03" rgba="0.95 0.5 0.15 1"/>
    </body>
  </worldbody>

  <equality>
    <!-- the shared drive shaft at each station: both turntables rotate together -->
    <joint joint1="tt_A1_rot" joint2="tt_B1_rot" polycoef="0 1 0 0 0"/>
    <joint joint1="tt_A2_rot" joint2="tt_B2_rot" polycoef="0 1 0 0 0"/>
    <!-- claw: gear pair mirrors the servo-driven right link onto the left;
         each jaw counter-rotates by its link angle (parallelogram: pads stay
         parallel); the inner (visual) links follow the outer ones -->
    <joint joint1="claw_l"  joint2="claw_r" polycoef="0 1 0 0 0"/>
    <joint joint1="jaw_r"   joint2="claw_r" polycoef="0 -1 0 0 0" class="rigid_link"/>
    <joint joint1="jaw_l"   joint2="claw_l" polycoef="0 -1 0 0 0" class="rigid_link"/>
    <joint joint1="link2_r" joint2="claw_r" polycoef="0 1 0 0 0"/>
    <joint joint1="link2_l" joint2="claw_l" polycoef="0 1 0 0 0"/>
    <joint joint1="claw_l_b2"  joint2="claw_r_b2" polycoef="0 1 0 0 0"/>
    <joint joint1="jaw_r_b2"   joint2="claw_r_b2" polycoef="0 -1 0 0 0" class="rigid_link"/>
    <joint joint1="jaw_l_b2"   joint2="claw_l_b2" polycoef="0 -1 0 0 0" class="rigid_link"/>
    <joint joint1="link2_r_b2" joint2="claw_r_b2" polycoef="0 1 0 0 0"/>
    <joint joint1="link2_l_b2" joint2="claw_l_b2" polycoef="0 1 0 0 0"/>
  </equality>

  <actuator>
    <!-- bot drive: same N20, direction resolved by which axis it's traveling -->
    <velocity name="drive_x" joint="bot_x" kv="40" ctrlrange="-0.13 0.13" forcerange="-8 8"/>
    <velocity name="drive_y" joint="bot_y" kv="40" ctrlrange="-0.13 0.13" forcerange="-8 8"/>
    <!-- bot yaw follows the turntable during rotation (soft lock behavior) -->
    <position name="yaw_hold" joint="bot_yaw" kp="20" forcerange="-3 3" ctrlrange="-0.1 1.67"/>
    <!-- one worm-geared motor per station drives the coupled pair; worm = stiff, not backdrivable -->
    <position name="tt_left"  joint="tt_A1_rot" kp="60" forcerange="-20 20" ctrlrange="0 1.5708"/>
    <position name="tt_right" joint="tt_A2_rot" kp="60" forcerange="-20 20" ctrlrange="0 1.5708"/>
    <!-- arm -->
    <velocity name="drive2_x" joint="b2_x" kv="40" ctrlrange="-0.13 0.13" forcerange="-8 8"/>
    <velocity name="drive2_y" joint="b2_y" kv="40" ctrlrange="-0.13 0.13" forcerange="-8 8"/>
    <position name="yaw2_hold" joint="b2_yaw" kp="20" forcerange="-3 3" ctrlrange="-0.1 1.67"/>
    <position class="sc15" name="a1" joint="j1_yaw" ctrlrange="-3.1 3.1"/>
    <position class="sc15" name="a2" joint="j2_shoulder" ctrlrange="-1.9 1.9"/>
    <position class="sc15" name="a3" joint="j3_elbow" ctrlrange="-2.4 2.4"/>
    <position class="sc15" name="a4" joint="j4_wrist_pitch" ctrlrange="-1.9 1.9"/>
    <position class="sc15" name="a5" joint="j5_wrist_roll" ctrlrange="-3.1 3.1"/>
    <position class="sc15" name="a1_b2" joint="j1_yaw_b2" ctrlrange="-3.1 3.1"/>
    <position class="sc15" name="a2_b2" joint="j2_shoulder_b2" ctrlrange="-1.9 1.9"/>
    <position class="sc15" name="a3_b2" joint="j3_elbow_b2" ctrlrange="-2.4 2.4"/>
    <position class="sc15" name="a4_b2" joint="j4_wrist_pitch_b2" ctrlrange="-1.9 1.9"/>
    <position class="sc15" name="a5_b2" joint="j5_wrist_roll_b2" ctrlrange="-3.1 3.1"/>
    <!-- claw servo (6th SC15): separate channel from the arm spline (§1.8) -->
    <position class="claw" name="claw" joint="claw_r"/>
    <position class="claw" name="claw_b2" joint="claw_r_b2"/>
  </actuator>

  <sensor>
    <jointpos name="bot_x_pos" joint="bot_x"/>
    <jointpos name="bot_y_pos" joint="bot_y"/>
    <jointpos name="bot_yaw_pos" joint="bot_yaw"/>
    <jointpos name="q1_pos" joint="j1_yaw"/>
    <jointpos name="q2_pos" joint="j2_shoulder"/>
    <jointpos name="q3_pos" joint="j3_elbow"/>
    <jointpos name="q4_pos" joint="j4_wrist_pitch"/>
    <jointpos name="q1_b2_pos" joint="j1_yaw_b2"/>
    <jointpos name="q2_b2_pos" joint="j2_shoulder_b2"/>
    <jointpos name="q3_b2_pos" joint="j3_elbow_b2"/>
    <jointpos name="q4_b2_pos" joint="j4_wrist_pitch_b2"/>
    <jointpos name="b2_x_pos" joint="b2_x"/>
    <jointpos name="b2_y_pos" joint="b2_y"/>
    <jointpos name="b2_yaw_pos" joint="b2_yaw"/>
    <jointpos name="tt_left_pos" joint="tt_A1_rot"/>
    <jointpos name="tt_right_pos" joint="tt_A2_rot"/>
    <jointpos name="claw_pos" joint="claw_r"/>
    <jointpos name="claw_b2_pos" joint="claw_r_b2"/>
  </sensor>
</mujoco>